# Copy to .env and fill with your Supabase project values.
# Never commit .env (it contains secrets).

SITE_URL=http://localhost/tour%20and%20travel%20website

# Public contact
WHATSAPP_NUMBER=254712136002
WHATSAPP_DISPLAY=+254 712 136002
CONTACT_EMAIL=gmegichuru@gmail.com
CONTACT_PHONE=0712 136002
CONTACT_ADDRESS=Westlands, Nairobi, Kenya

# Admin (used by install.php / seed)
ADMIN_EMAIL=gmegichuru@gmail.com
ADMIN_DEFAULT_PASSWORD=admin123

# Supabase API (Dashboard → Project Settings → API)
# Prefer either naming style; config.php accepts both.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY
# Legacy aliases (optional if publishable/secret above are set)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Supabase Postgres (Dashboard → Project Settings → Database)
# Host is db.<project-ref>.supabase.co — paste the database password from the dashboard.
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=YOUR_DATABASE_PASSWORD
DB_SSLMODE=require

# Optional integrations
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=gmegichuru@gmail.com
MPESA_ENABLED=false
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
